body {
  margin: 0;
  padding: 0;
  font-family: 'Arial', sans-serif;
  background-color: #000;
  color: #fff;
  direction: rtl;
  text-align: center;
}

.container {
  padding: 20px;
  max-width: 600px;
  margin: auto;
}

h1 {
  font-size: 28px;
  margin-bottom: 5px;
}

#username {
  font-size: 14px;
  margin-bottom: 20px;
  color: #aaa;
}

#question-container {
  font-size: 20px;
  margin-bottom: 20px;
}

#options-container button {
  display: block;
  width: 100%;
  margin: 10px 0;
  padding: 12px;
  font-size: 16px;
  background-color: #222;
  color: white;
  border: 1px solid #444;
  cursor: pointer;
  border-radius: 8px;
}

#options-container button:hover {
  background-color: #333;
}

#next-button {
  margin-top: 20px;
  padding: 12px 20px;
  font-size: 16px;
  background-color: #4CAF50;
  border: none;
  color: white;
  border-radius: 8px;
  cursor: pointer;
}

#next-button:hover {
  background-color: #45a049;
}

.hidden {
  display: none;
}

#result-container {
  margin-top: 30px;
  font-size: 22px;
  font-weight: bold;
}
